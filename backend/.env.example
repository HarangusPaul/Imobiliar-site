# Local development configuration. Copy to `.env` and adjust.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-only-not-a-real-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local instance)
DATABASE_URL=postgres://imobiliar:imobiliar@localhost:5432/imobiliar

# Frontend origin allowed to call the API during development
FRONTEND_ORIGIN=http://localhost:3000

# --- Pluggable service implementations -------------------------------------
# config wires these dotted paths into the runtime registry. Swapping an
# implementation is a settings change, never a domain-app change.
SERVICE_NOTIFICATIONS=services.notifications.console.ConsoleNotificationService
SERVICE_VERIFICATION=services.verification.console.ConsoleVerificationService
SERVICE_STORAGE=services.storage.local.LocalFileStorageService
SERVICE_ANALYTICS=services.analytics.noop.NoopAnalyticsService

# Local filesystem root used by services.storage.local
LOCAL_STORAGE_ROOT=var/media
LOCAL_STORAGE_BASE_URL=/media/

# --- Domain policy knobs owned by apps/accounts ----------------------------
ACCOUNTS_OTP_TTL_SECONDS=300
ACCOUNTS_OTP_MAX_ATTEMPTS=5
